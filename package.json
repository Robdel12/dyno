{
  "name": "dyno",
  "version": "0.1.0",
  "description": "Browser-local acceptance tests from a URL",
  "type": "module",
  "bin": {
    "dyno": "./bin/dyno.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/browser/index.js"
    },
    "./config": {
      "types": "./types/config.d.ts",
      "default": "./src/config.js"
    }
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "vision.md",
    "docs/guide.md",
    "docs/browsers.md",
    "docs/research/screenshots.md",
    "docs/research/interactors.md",
    "docs/architecture.md",
    "docs/design.md",
    "docs/ci.md",
    "types"
  ],
  "scripts": {
    "test": "node scripts/test.js",
    "test:core": "node scripts/test.js core",
    "test:browser": "node scripts/test.js browser",
    "test:package": "node scripts/test.js package",
    "test:capture": "node scripts/test.js capture",
    "test:firefox": "node scripts/test.js browser firefox",
    "test:vizzly": "node bin/dyno.js --config examples/vizzly/dyno.config.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "esbuild": "0.28.2",
    "interactor.js": "3.6.2",
    "parse5": "8.0.0",
    "pngjs": "7.0.0"
  },
  "private": true,
  "devDependencies": {
    "playwright-core": "1.64.1",
    "selenium-webdriver": "4.51.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "playwright-core": "^1.64.1",
    "selenium-webdriver": "^4.51.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    },
    "selenium-webdriver": {
      "optional": true
    }
  },
  "types": "./types/index.d.ts"
}
