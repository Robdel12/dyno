{
  "name": "dyno",
  "version": "0.1.0",
  "description": "Browser-local acceptance tests from a URL",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dyno": "./bin/dyno.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/browser/index.js"
    },
    "./config": {
      "types": "./types/config.d.ts",
      "default": "./src/config.js"
    },
    "./fixtures": {
      "types": "./types/fixtures.d.ts",
      "default": "./src/fixtures.js"
    },
    "./coverage": {
      "types": "./types/coverage.d.ts",
      "default": "./src/coverage-instrument.js"
    }
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "vision.md",
    "docs/guide.md",
    "docs/api.md",
    "docs/browsers.md",
    "docs/architecture.md",
    "docs/design.md",
    "docs/ci.md",
    "docs/documentation.md",
    "types",
    "vendor"
  ],
  "scripts": {
    "vendor:interactor": "node scripts/vendor-interactor.js",
    "test": "node scripts/test.js",
    "test:core": "node scripts/test.js core",
    "test:browser": "node scripts/test.js browser",
    "test:execution": "node scripts/test.js execution",
    "test:repeat": "node scripts/test.js repeat",
    "test:project": "node scripts/test.js project",
    "test:reporter": "node scripts/test.js reporter",
    "test:package": "node scripts/test.js package",
    "test:capture": "node scripts/test.js capture",
    "test:firefox": "node scripts/test.js browser firefox",
    "test:vizzly": "node bin/dyno.js --config examples/vizzly/dyno.config.js",
    "test:native": "node scripts/test.js native",
    "test:coverage": "node scripts/coverage.js",
    "test:coverage:check": "node scripts/coverage.js --check"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "commander": "15.0.0",
    "esbuild": "0.28.2",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-lib-source-maps": "5.0.6",
    "istanbul-reports": "3.2.0",
    "parse5": "8.0.0",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@types/node": "24.19.2",
    "pnpm": "11.28.13",
    "typescript": "5.9.3"
  },
  "types": "./types/index.d.ts"
}
