{
  "name": "dyno",
  "version": "0.1.0",
  "description": "Browser-local acceptance tests from a URL",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dyno": "./bin/dyno.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/browser/index.js"
    },
    "./config": {
      "types": "./types/config.d.ts",
      "default": "./src/config.js"
    },
    "./fixtures": {
      "types": "./types/fixtures.d.ts",
      "default": "./src/fixtures.js"
    }
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "vision.md",
    "docs/guide.md",
    "docs/api.md",
    "docs/browsers.md",
    "docs/architecture.md",
    "docs/design.md",
    "docs/ci.md",
    "docs/documentation.md",
    "types"
  ],
  "scripts": {
    "test": "node scripts/test.js",
    "test:core": "node scripts/test.js core",
    "test:browser": "node scripts/test.js browser",
    "test:execution": "node scripts/test.js execution",
    "test:project": "node scripts/test.js project",
    "test:reporter": "node scripts/test.js reporter",
    "test:package": "node scripts/test.js package",
    "test:capture": "node scripts/test.js capture",
    "test:firefox": "node scripts/test.js browser firefox",
    "test:vizzly": "node bin/dyno.js --config examples/vizzly/dyno.config.js",
    "test:native": "node scripts/test.js native"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "commander": "15.0.0",
    "esbuild": "0.28.2",
    "interactor.js": "git+https://github.com/wwilsman/interactor.js.git#d22e523485359a924cedfbc32ee3912c80319dbb",
    "parse5": "8.0.0",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  },
  "types": "./types/index.d.ts"
}
